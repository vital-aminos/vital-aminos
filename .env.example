# Prisma / Neon Postgres
# Pooled connection (used at runtime) — Neon "Connection string" with ?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&pgbouncer=true"
# Direct (non-pooled) connection — used for migrations. Neon "Connection string" without pgbouncer.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Auth.js
AUTH_SECRET="replace-with-output-of--npx-auth-secret"
AUTH_GOOGLE_ID="replace-with-google-oauth-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-oauth-client-secret"

# Base URL of the site (used for OAuth callback + links). Update per environment.
NEXTAUTH_URL="http://localhost:3000"

# Comma-separated list of emails that should be auto-promoted to admin the first time
# they sign in (in addition to any User rows with isAdmin=true already set in the DB).
ADMIN_EMAILS="you@example.com"
